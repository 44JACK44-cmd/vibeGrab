# VibeGrab backend configuration (EXAMPLE).
#
# Local development: copy this file to `.env`  ->  copy .env.example .env
# Production (Render): set these in the dashboard as Environment Variables.
#   The `.env` file is NOT shipped in the Docker image.
# `.env` must never be committed (it is git-ignored).

APP_NAME=VibeGrab API
VERSION=0.2.0
DEBUG=false

HOST=0.0.0.0
PORT=8000

DOWNLOAD_DIR=downloads
TEMP_DIR=temp
MAX_CONCURRENT_DOWNLOADS=2
MAX_FILE_SIZE_MB=2048
MIN_FREE_SPACE_MB=500

# Resolve the tools from PATH so the config stays portable across machines.
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# CORS: comma-separated origins, or * for any. Credentials must stay false.
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# --- Security ---
# Leave empty to disable API-key auth. When set, every /api/* request must
# send this value in the "X-API-Key" header.
API_KEY=

# Per-client rate limit (in-memory, per instance). Disable with false.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WINDOW_SECONDS=60

# Hosts the explore proxy may relay from (comma-separated suffix match).
RELAY_ALLOWED_HOSTS=googlevideo.com,f5.si
